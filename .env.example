# ==========================================
# RASHID STORE - BACKEND ENVIRONMENT CONFIG
# ==========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/rashid-store
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rashid-store?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rashid-store

# JWT Authentication
JWT_SECRET=rashid_store_super_secure_jwt_secret_2026_dev_key
JWT_EXPIRES_IN=30d
COOKIE_EXPIRES_IN=30

# Initial Admin Password for seeding
ADMIN_INITIAL_PASSWORD=Admin@123456
